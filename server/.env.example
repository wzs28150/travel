# 服务器原生部署用（系统自带 MySQL，不走 Docker）
# 复制本文件为 .env 后修改实际值；后端启动时会自动加载（import 'dotenv/config'）

# 后端监听端口（前端 nginx 反代会指向它）
PORT=8089

# 上传文件返回路径前缀：生产填空串，由 nginx 反代 /uploads
BASE_URL=

# 连接系统 MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请改成你的系统MySQL密码
DB_NAME=travel_db

# 安全：务必改成随机长字符串
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# 上传目录与存储上限（默认 2GB）
UPLOAD_DIR=uploads
STORAGE_LIMIT=2147483648
