# 服务端口
PORT=3000

# 前端访问后端的基础地址（用于拼接上传文件 URL，开发时为后端地址）
BASE_URL=http://localhost:3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=travel_db

# JWT 密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES=7d

# 上传文件存放目录（相对 server 目录）
UPLOAD_DIR=uploads

# 用户默认存储空间（字节）。2GB = 2 * 1024 * 1024 * 1024
STORAGE_LIMIT=2147483648
